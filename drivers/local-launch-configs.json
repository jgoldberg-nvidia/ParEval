{
    "serial": {
        "format": "{exec_path} {args}",
        "params": [{}]
    },
    "omp": {
        "format": "{exec_path} {args} {num_threads}",
        "params": [
            {"num_threads": 1},
            {"num_threads": 2},
            {"num_threads": 4},
            {"num_threads": 8}
        ]
    },
    "mpi": {
        "format": "mpirun --allow-run-as-root -n {num_procs} {exec_path} {args}",
        "params": [
            {"num_procs": 1},
            {"num_procs": 2},
            {"num_procs": 4}
        ]
    },
    "mpi+omp": {
        "format": "mpirun --allow-run-as-root -n {num_procs} {exec_path} {args} {num_threads}",
        "params": [
            {"num_procs": 1, "num_threads": 1},
            {"num_procs": 1, "num_threads": 2},
            {"num_procs": 2, "num_threads": 2}
        ]
    },
    "kokkos": {
        "format": "{exec_path} {args} --kokkos-num-threads={num_threads}",
        "params": [
            {"num_threads": 1},
            {"num_threads": 2},
            {"num_threads": 4}
        ]
    },
    "cuda": {
        "format": "{exec_path} {args}",
        "params": [{}]
    }
}
